# SourceKrillion server settings. Copy to .env (never commit .env).

# Free Groq API key from https://console.groq.com — powers the daily AI-generated puzzle.
# Leave empty to use the built-in classic pool only.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Secret word: typing it as an answer always scores the deepest tier.
# Set it here only, on your server. Leave empty to turn it off.
DEEP_WORD=

# First day of the game (Dive #1, start of the archive). YYYY-MM-DD
LAUNCH_DATE=2026-11-24

# Optional: token for POST /api/admin/generate {"date":"YYYY-MM-DD"} (Authorization: Bearer ...)
ADMIN_TOKEN=

# Optional: extra origins allowed to POST (comma-separated), e.g. if you put a web front end elsewhere.
# ALLOWED_ORIGINS=
